---
import '../styles/global.css';
const {
  title = 'simplifi | Microsoft Dynamics 365 Finance Consulting',
  description = 'Finance. Technology. Simplified. Beratung und Lösungen rund um Microsoft Dynamics 365 Finance.'
} = Astro.props;
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="de">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />
  <meta name="description" content={description} />
  <title>{title}</title>
</head>
<body>
<header class="site-header">
  <div class="container navbar">
    <a class="brand" href={base}>simplifi<small>solutions</small></a>
    <nav class="navlinks">
      <a href={`${base}#leistungen`}>Leistungen</a>
      <a href={`${base}#expertise`}>Expertise</a>
      <a href={`${base}#insights`}>Insights</a>
      <a href={`${base}#about`}>Über simplifi</a>
      <a href={`${base}#kontakt`}>Kontakt</a>
    </nav>
    <a class="btn btn-outline" href={`${base}#kontakt`}>Kontakt aufnehmen</a>
  </div>
</header>
<slot />
<footer class="footer">
  <div class="container footer-grid">
    <div>
      <div class="brand" style="color:white">simplifi<small>solutions</small></div>
      <p>Finance. Technology. Simplified.</p>
      <p>Wir optimieren Finanzprozesse und schaffen klare Lösungen mit Microsoft Dynamics 365 Finance.</p>
    </div>
    <div>
      <h4>Navigation</h4>
      <a href={`${base}#leistungen`}>Leistungen</a>
      <a href={`${base}#expertise`}>Expertise</a>
      <a href={`${base}#insights`}>Insights</a>
      <a href={`${base}#kontakt`}>Kontakt</a>
    </div>
    <div>
      <h4>Kontakt</h4>
      <p>simplifi gmbh<br/>Winkel, Schweiz</p>
      <a href="mailto:contact@simplifi.solutions">contact@simplifi.solutions</a>
    </div>
  </div>
  <div class="container footer-bottom">© 2026 simplifi gmbh · Alle Rechte vorbehalten.</div>
</footer>
</body>
</html>
