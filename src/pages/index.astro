---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const base = import.meta.env.BASE_URL;
---

<BaseLayout>

  <section class="hero">
    <div class="container">
      <div class="hero-inner">
        <h1>Finance.<br />Technology.<br /><span>Simplified.</span></h1>

        <p>
          Wir unterstützen Unternehmen dabei, Finanzprozesse zu optimieren und
          Microsoft Dynamics 365 Finance erfolgreich zu nutzen.
        </p>

        <div class="hero-actions">
          <a class="btn btn-primary" href="#leistungen">
            Unsere Leistungen
          </a>

          <a class="btn btn-secondary" href="#insights">
            Insights entdecken
          </a>
        </div>
      </div>
    </div>
  </section>


  <section id="leistungen" class="section">
    <div class="container">

      <div class="section-head">
        <div class="eyebrow">Was wir tun</div>

        <h2>
          Klare Lösungen für komplexe Finanzprozesse
        </h2>
      </div>


      <div class="services-wrap" id="expertise">

        <button
          class="services-arrow services-prev"
          type="button"
          aria-label="Vorherige Leistungen"
        >
          ‹
        </button>


        <div class="services">

          <article class="service">
            <div class="icon">D365</div>

            <h3>
              Microsoft Dynamics 365 Finance
            </h3>

            <p>
              Implementierung, Optimierung und Weiterentwicklung Ihrer
              D365-Finance-Lösung.
            </p>

            <a class="more" href="#kontakt">
              Mehr erfahren →
            </a>
          </article>


          <article class="service">
            <div class="icon">SA</div>

            <h3>
              Solution Architecture
            </h3>

            <p>
              Skalierbare, sichere und zukunftsfähige Architekturen für Ihre
              Anforderungen.
            </p>

            <a class="more" href="#kontakt">
              Mehr erfahren →
            </a>
          </article>


          <article class="service">
            <div class="icon">BANK</div>

            <h3>
              Banking Integration
            </h3>

            <p>
              Direkte Bankanbindung an D365 Finance über EBICS mit gängigen Formaten und automatisierter Abstimmung..
            </p>

            <a class="more" href="/banking-integration">
              Mehr erfahren →
            </a>
          </article>


          <article class="service">
            <div class="icon">PAY</div>

            <h3>
              Payment Integration
            </h3>

            <p>
              Integration von Zahlungsdienstleistern, Kreditkartenprozessen
              und Digital Commerce Platforms mit automatisierter Verarbeitung
              und Abstimmung in D365 Finance.
            </p>

            <a class="more" href="/payment-integration">
              Mehr erfahren →
            </a>
          </article>


          <article class="service">
            <div class="icon">ER</div>

            <h3>
              Electronic Reporting
            </h3>

            <p>
              Regulatorische und kundenspezifische Formate effizient
              automatisieren und sicher bereitstellen.
            </p>

            <a class="more" href="#kontakt">
              Mehr erfahren →
            </a>
          </article>

        </div>


        <button
          class="services-arrow services-next"
          type="button"
          aria-label="Weitere Leistungen"
        >
          ›
        </button>

      </div>

    </div>
  </section>


  <section id="insights" class="section section-soft">
    <div class="container">

      <div class="section-head">
        <div class="eyebrow">
          Aktuelle Insights
        </div>

        <h2>
          Wissen teilen. Mehrwert schaffen.
        </h2>

        <p>
          Praxisnahe Beiträge zu Dynamics 365 Finance, Banking und Electronic Reporting.
        </p>
      </div>


      <div class="insights">

        {posts.map((post) => (
          <article class="card">

            <div class="card-media"></div>

            <div class="card-body">

              <time>
                {post.data.date.toLocaleDateString('de-CH')}
              </time>

              <h3>
                {post.data.title}
              </h3>

              <p>
                {post.data.description}
              </p>

              <a
                class="more"
                href={`${base}insights/${post.id}/`}
              >
                Mehr lesen →
              </a>

            </div>

          </article>
        ))}

      </div>

    </div>
  </section>


  <section id="about" class="section">
    <div class="container">

      <div class="section-head">

        <div class="eyebrow">
          Über simplifi
        </div>

        <h2>
          Finance-Know-how trifft Technologie
        </h2>

        <p>
          simplifi unterstützt Unternehmen bei der Konzeption,
          Implementierung und Optimierung moderner Finance-Lösungen
          auf Basis von Microsoft Dynamics 365.
        </p>

      </div>

    </div>
  </section>


  <section id="kontakt" class="section-soft">
    <div class="container cta">

      <div>

        <h3>
          Lassen Sie uns über Ihre Herausforderungen sprechen.
        </h3>

        <p>
          Wir freuen uns auf den Austausch mit Ihnen.
        </p>

      </div>


      <a
        class="btn btn-primary"
        href="mailto:contact@simplifi.solutions"
      >
        Kontakt aufnehmen
      </a>

    </div>
  </section>


  <script>
    const services = document.querySelector('.services');
    const prev = document.querySelector('.services-prev');
    const next = document.querySelector('.services-next');

    prev?.addEventListener('click', () => {
      services?.scrollBy({
        left: -320,
        behavior: 'smooth'
      });
    });

    next?.addEventListener('click', () => {
      services?.scrollBy({
        left: 320,
        behavior: 'smooth'
      });
    });
  </script>

</BaseLayout>
