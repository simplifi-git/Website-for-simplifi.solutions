---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Banking Integration für Microsoft Dynamics 365 Finance | simplifi';
const description = 'Banking Integration für Microsoft Dynamics 365 Finance mit EBICS, SFTP, CAMT.053 und MT940: automatischer Download, Import, Validierung, Zuordnung und Abstimmung von Bankkontoauszügen.';
---

<BaseLayout title={title} description={description}>
  <main>
    <section class="service-hero">
      <div class="container service-hero-inner">
        <span class="service-kicker">Microsoft Dynamics 365 Finance · Banking Integration</span>
        <h1>Banking Integration für Microsoft Dynamics 365 Finance</h1>
        <p class="service-lead">
          Wir verbinden Banken sicher mit Microsoft Dynamics 365 Finance und automatisieren den
          Import und die Verarbeitung von Bankkontoauszügen – von der Übertragung über EBICS oder
          SFTP bis zur Validierung, Zuordnung, Buchung und Abstimmung in D365 Finance.
        </p>
        <div class="service-actions">
          <a class="btn btn-primary" href="mailto:contact@simplifi.solutions?subject=Banking%20Integration%20D365%20Finance">Banking Integration besprechen</a>
          <a class="btn btn-secondary" href="#loesung">Lösung ansehen</a>
        </div>
      </div>
    </section>

    <section class="section" id="loesung">
      <div class="container">
        <div class="section-head">
          <span class="eyebrow">Sicher. Flexibel. Automatisiert.</span>
          <h2>Vom Bankkontoauszug direkt in D365 Finance</h2>
          <p>
            Kontoauszüge werden über standardisierte und sichere Übertragungswege in Microsoft
            Dynamics 365 Finance übernommen. Unterstützt werden insbesondere CAMT.053 nach ISO 20022
            und MT940.
          </p>
        </div>

        <div class="service-visual">
          <img src="/images/banking-integration-d365-finance.png"
               alt="Banking Integration mit Microsoft Dynamics 365 Finance über EBICS und SFTP für MT940 und CAMT.053"
               loading="lazy" />
        </div>
        <p class="visual-caption">
          Bankkontoauszüge über EBICS, SFTP oder manuellen Upload sicher in D365 Finance importieren und weiterverarbeiten.
        </p>
      </div>
    </section>

    <section class="section section-soft">
      <div class="container">
        <div class="section-head">
          <span class="eyebrow">Anbindungsvarianten</span>
          <h2>Flexible Bankkommunikation</h2>
          <p>
            Je nach Bank und technischer Infrastruktur realisieren wir die Anbindung über EBICS oder
            SFTP. Für Sonderfälle bleibt ein kontrollierter manueller Dateiimport möglich.
          </p>
        </div>

        <div class="service-grid three">
          <article class="service-card">
            <span class="card-tag">EBICS</span>
            <h3>Elektronische Bankkommunikation</h3>
            <p>Sicherer Abruf von Bankdateien über EBICS. Kontoauszüge können automatisiert bereitgestellt und ohne manuellen Download aus dem Bankportal in den D365-Prozess übernommen werden.</p>
          </article>
          <article class="service-card">
            <span class="card-tag">SFTP</span>
            <h3>Sichere Dateiübertragung</h3>
            <p>Übertragung über SFTP/SSH für Banken, die Dateien über einen sicheren Transferkanal bereitstellen. Dateierkennung und Verarbeitung werden auf den jeweiligen Bankprozess abgestimmt.</p>
          </article>
          <article class="service-card">
            <span class="card-tag">Fallback</span>
            <h3>Manueller Import</h3>
            <p>MT940- oder CAMT.053-Dateien können bei Bedarf weiterhin kontrolliert manuell hochgeladen, geprüft und verarbeitet werden.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container service-split">
        <div>
          <span class="eyebrow">Unterstützte Formate</span>
          <h2>CAMT.053 und MT940</h2>
          <p>Die Lösung unterstützt standardisierte Bankkontoauszugsformate und deren strukturierte Weiterverarbeitung in Microsoft Dynamics 365 Finance.</p>
          <div class="format-list">
            <div><strong>CAMT.053</strong><span>ISO-20022-Kontoauszug mit strukturierten Bankinformationen.</span></div>
            <div><strong>MT940</strong><span>SWIFT-Format für elektronische Kontoauszüge.</span></div>
          </div>
        </div>

        <div>
          <span class="eyebrow">Verarbeitung in D365 Finance</span>
          <h2>Automatisierter End-to-End-Prozess</h2>
          <div class="process-list">
            <div><strong>1. Import</strong><span>Automatische oder manuelle Übernahme der Bankdatei.</span></div>
            <div><strong>2. Validierung</strong><span>Prüfung von Datei, Format und relevanten Bankinformationen.</span></div>
            <div><strong>3. Zuordnung</strong><span>Zuordnung zum richtigen Bankkonto und Verarbeitung der Transaktionen.</span></div>
            <div><strong>4. Buchung &amp; Abstimmung</strong><span>Unterstützung des Bankabgleichs und der weiteren Verbuchung.</span></div>
          </div>
        </div>
      </div>
    </section>

    <section class="section section-soft">
      <div class="container">
        <div class="section-head">
          <span class="eyebrow">Automatisierung</span>
          <h2>Weniger manuelle Schritte im täglichen Bankprozess</h2>
          <p>Der automatisierte Download und die integrierte Verarbeitung reduzieren wiederkehrende Tätigkeiten und machen Bankinformationen schneller in D365 Finance verfügbar.</p>
        </div>
        <div class="benefit-grid">
          <div class="benefit"><h3>Automatischer Download</h3><p>Kontoauszüge werden über die definierte Bankverbindung automatisch bereitgestellt.</p></div>
          <div class="benefit"><h3>Automatische Zuordnung</h3><p>Bankdateien und Transaktionen können den relevanten Bankkonten und Prozessen zugeordnet werden.</p></div>
          <div class="benefit"><h3>Regelbasierte Verarbeitung</h3><p>Wiederkehrende Geschäftsvorfälle lassen sich anhand definierter Regeln verarbeiten.</p></div>
          <div class="benefit"><h3>Abstimmung &amp; Abgleich</h3><p>Die Verarbeitung unterstützt transparente Buchungs- und Reconciliation-Prozesse.</p></div>
          <div class="benefit"><h3>Sicherheit</h3><p>Verschlüsselte Übertragung, Authentifizierung und kontrollierte Verarbeitung.</p></div>
          <div class="benefit"><h3>Nachvollziehbarkeit</h3><p>Klare Prozessschritte, Fehlerkontrolle und transparente Verarbeitung.</p></div>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container crosslink">
        <span class="eyebrow">Weitere Integrationen</span>
        <h2>Auch Payment Provider und Digital Commerce Platforms</h2>
        <p>Neben klassischen Bankanbindungen integrieren wir Microsoft Dynamics 365 Finance auch mit Zahlungsdienstleistern, Kreditkartenprozessen und digitalen Plattformen.</p>
        <a class="more" href="/payment-integration">Mehr zu Payment Integration →</a>
      </div>
    </section>

    <section class="service-cta">
      <div class="container service-cta-inner">
        <div>
          <span class="eyebrow">Banking Integration</span>
          <h2>Bankkontoauszüge in D365 Finance automatisieren</h2>
          <p>Wir unterstützen bei Konzeption, Bankanbindung, Formatkonfiguration, Testing, Produktivsetzung und Optimierung.</p>
        </div>
        <a class="btn btn-primary" href="mailto:contact@simplifi.solutions?subject=Banking%20Integration%20D365%20Finance">Kontakt aufnehmen</a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .service-hero {
    background:
      radial-gradient(circle at 82% 18%, rgba(11,103,227,.20), transparent 35%),
      linear-gradient(120deg, #071a33 0%, #0a2343 62%, #0b3766 100%);
    color: #fff;
  }
  .service-hero-inner { max-width: 920px; padding: 96px 0 88px; }
  .service-kicker {
    display:block; margin-bottom:18px; color:var(--blue-light);
    text-transform:uppercase; letter-spacing:.12em; font-size:.78rem; font-weight:800;
  }
  .service-hero h1 {
    max-width:920px; margin:0 0 24px; font-size:clamp(2.7rem,6vw,4.9rem);
    line-height:1.02; letter-spacing:-.05em;
  }
  .service-lead { max-width:820px; margin:0 0 30px; color:#dce9f7; font-size:1.14rem; }
  .service-actions { display:flex; flex-wrap:wrap; gap:14px; }
  .service-visual {
    margin-top:34px; overflow:hidden; border:1px solid var(--line); border-radius:16px;
    background:#fff; box-shadow:0 18px 48px rgba(12,27,47,.08);
  }
  .service-visual img { display:block; width:100%; height:auto; }
  .visual-caption { margin:14px 4px 0; color:var(--muted); font-size:.88rem; text-align:center; }
  .service-grid { display:grid; gap:20px; }
  .service-grid.three { grid-template-columns:repeat(3,1fr); }
  .service-grid.four { grid-template-columns:repeat(4,1fr); }
  .service-card {
    padding:28px; border:1px solid var(--line); border-radius:12px; background:#fff;
    box-shadow:0 12px 34px rgba(12,27,47,.05);
  }
  .service-card h3 { margin:10px 0; }
  .service-card p { margin:0; color:var(--muted); }
  .card-tag {
    color:var(--blue); font-size:.75rem; font-weight:800; letter-spacing:.1em; text-transform:uppercase;
  }
  .service-split { display:grid; grid-template-columns:1fr 1fr; gap:72px; align-items:center; }
  .service-split h2,.crosslink h2,.service-cta h2 {
    margin:10px 0 18px; font-size:clamp(2rem,4vw,3rem); line-height:1.08; letter-spacing:-.035em;
  }
  .service-split p,.crosslink p { color:var(--muted); }
  .format-list,.process-list { display:grid; gap:12px; margin-top:24px; }
  .format-list div,.process-list div {
    padding:17px 18px; border:1px solid var(--line); border-left:4px solid var(--blue);
    border-radius:8px; background:#fff;
  }
  .format-list strong,.format-list span,.process-list strong,.process-list span { display:block; }
  .format-list span,.process-list span { margin-top:4px; color:var(--muted); font-size:.92rem; }
  .benefit-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:18px; }
  .benefit {
    padding:24px; border-top:3px solid var(--blue); border-radius:0 0 10px 10px;
    background:#fff; box-shadow:0 10px 30px rgba(12,27,47,.05);
  }
  .benefit h3 { margin:0 0 8px; }
  .benefit p { margin:0; color:var(--muted); }
  .crosslink {
    border:1px solid #d7e3f2; border-radius:16px; padding:36px;
    background:linear-gradient(135deg,#f8fbff 0%,#eef5ff 100%);
  }
  .crosslink .more { display:inline-block; margin-top:8px; }
  .service-cta { background:var(--navy); color:#fff; }
  .service-cta-inner { display:flex; justify-content:space-between; gap:50px; align-items:center; padding:62px 0; }
  .service-cta p { margin-bottom:0; color:#c9d8e8; }
  @media(max-width:950px){
    .service-grid.four{grid-template-columns:repeat(2,1fr)}
    .service-grid.three,.benefit-grid{grid-template-columns:repeat(2,1fr)}
    .service-split{grid-template-columns:1fr;gap:38px}
  }
  @media(max-width:620px){
    .service-hero-inner{padding:70px 0 64px}
    .service-grid.three,.service-grid.four,.benefit-grid{grid-template-columns:1fr}
    .service-cta-inner{align-items:flex-start;flex-direction:column}
    .crosslink{padding:26px}
  }
</style>
