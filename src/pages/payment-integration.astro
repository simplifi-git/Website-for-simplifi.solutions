---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Payment Integration für Microsoft Dynamics 365 Finance | simplifi';
const description = 'Payment Integration für Microsoft Dynamics 365 Finance: Zahlungsdienstleister, Kreditkartenabrechnungen und Digital Commerce Platforms mit automatisierter Zuordnung, Verarbeitung und Abstimmung.';
---

<BaseLayout title={title} description={description}>
  <main>
    <section class="service-hero">
      <div class="container service-hero-inner">
        <span class="service-kicker">Microsoft Dynamics 365 Finance · Payment Integration</span>
        <h1>Payment Integration für Microsoft Dynamics 365 Finance</h1>
        <p class="service-lead">
          Wir integrieren Zahlungsdienstleister, Kreditkartenprozesse und Digital Commerce Platforms
          mit Microsoft Dynamics 365 Finance und automatisieren die Verarbeitung eingehender Zahlungs-
          und Abrechnungsdaten.
        </p>
        <div class="service-actions">
          <a class="btn btn-primary" href="mailto:contact@simplifi.solutions?subject=Payment%20Integration%20D365%20Finance">Payment Integration besprechen</a>
          <a class="btn btn-secondary" href="#loesung">Lösung ansehen</a>
        </div>
      </div>
    </section>

    <section class="section" id="loesung">
      <div class="container">
        <div class="section-head">
          <span class="eyebrow">Import. Verarbeitung. Automatisierung.</span>
          <h2>Zahlungsdaten aus unterschiedlichen Quellen zentral in D365 Finance</h2>
          <p>
            Zahlungs- und Abrechnungsdaten können aus unterschiedlichen Quellen in einen
            standardisierten D365-Finance-Prozess überführt werden. Dazu zählen insbesondere
            Payment Provider, Kreditkartenabrechnungen und Digital Commerce Platforms.
          </p>
        </div>

        <div class="service-visual">
          <img src="/images/payment-integration-d365-finance.png"
               alt="Payment Integration mit Microsoft Dynamics 365 Finance für Zahlungsdienstleister, Kreditkarten und Digital Commerce Platforms"
               loading="lazy" />
        </div>
        <p class="visual-caption">
          Unterschiedliche Zahlungsquellen werden in D365 Finance zusammengeführt und automatisiert zugeordnet, verarbeitet und abgestimmt.
        </p>
      </div>
    </section>

    <section class="section section-soft">
      <div class="container">
        <div class="section-head">
          <span class="eyebrow">Integrationsszenarien</span>
          <h2>Payment Provider, Karten und digitale Plattformen</h2>
          <p>Wir gestalten die Integration passend zu Datenquelle, Abrechnungslogik und bestehendem Finanzprozess in Microsoft Dynamics 365 Finance.</p>
        </div>

        <div class="service-grid four">
          <article class="service-card">
            <span class="card-tag">Payment Provider</span>
            <h3>Zahlungsdienstleister</h3>
            <p>Integration von Abrechnungs- und Transaktionsdaten aus Zahlungsplattformen zur strukturierten Weiterverarbeitung in D365 Finance.</p>
          </article>
          <article class="service-card">
            <span class="card-tag">Cards</span>
            <h3>Kreditkartenabrechnungen</h3>
            <p>Einlesen und Verarbeitung von Kreditkartenabrechnungen mit Zuordnung zum passenden Konto, Prozess und Buchungskontext.</p>
          </article>
          <article class="service-card">
            <span class="card-tag">Commerce</span>
            <h3>Digital Commerce Platforms</h3>
            <p>Integration von Zahlungs- und Abrechnungsinformationen aus Marktplätzen und digitalen Verkaufsplattformen.</p>
          </article>
          <article class="service-card">
            <span class="card-tag">Weitere Quellen</span>
            <h3>Individuelle Zahlungsquellen</h3>
            <p>Auch weitere externe Abrechnungs- oder Payment-Daten können in den standardisierten Verarbeitungsprozess integriert werden.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container service-split">
        <div>
          <span class="eyebrow">Automatisierte Verarbeitung</span>
          <h2>Von der Zahlungsdatei bis zur Abstimmung</h2>
          <p>Ziel ist ein möglichst durchgängiger Prozess mit klarer Zuordnung und möglichst wenig manueller Nachbearbeitung.</p>
          <div class="process-list">
            <div><strong>1. Import</strong><span>Übernahme der Zahlungs- oder Abrechnungsdaten.</span></div>
            <div><strong>2. Erkennung</strong><span>Identifikation relevanter Informationen und Zuordnungsmerkmale.</span></div>
            <div><strong>3. Regelbasierte Verarbeitung</strong><span>Automatisierte Zuordnung und Verarbeitung anhand definierter Regeln.</span></div>
            <div><strong>4. Abstimmung</strong><span>Unterstützung von Reconciliation, Buchung und transparenter Nachverfolgung.</span></div>
          </div>
        </div>

        <div>
          <span class="eyebrow">Business Value</span>
          <h2>Weniger Aufwand. Mehr Kontrolle.</h2>
          <div class="format-list">
            <div><strong>Automatische Zuordnung</strong><span>Reduziert manuelle Recherche und wiederkehrende Zuordnungsarbeit.</span></div>
            <div><strong>Reibungsloser Datenabgleich</strong><span>Unterstützt konsistente Abstimmung zwischen externen Quellen und D365 Finance.</span></div>
            <div><strong>Transparenz &amp; Reporting</strong><span>Strukturierte Verarbeitung verbessert Nachvollziehbarkeit und Reporting.</span></div>
            <div><strong>Skalierbarkeit</strong><span>Neue Quellen und Plattformen können in ein einheitliches Verarbeitungskonzept integriert werden.</span></div>
          </div>
        </div>
      </div>
    </section>

    <section class="section section-soft">
      <div class="container">
        <div class="section-head">
          <span class="eyebrow">Processing &amp; Reconciliation</span>
          <h2>Automatisierung entlang des gesamten Payment-Prozesses</h2>
          <p>Die Integration endet nicht beim Import. Wir betrachten die vollständige Verarbeitung bis zur Zuordnung, Abstimmung und transparenten Nachverfolgung.</p>
        </div>
        <div class="benefit-grid">
          <div class="benefit"><h3>Automatische Zuordnung</h3><p>Transaktionen werden anhand geeigneter Merkmale und Regeln zugeordnet.</p></div>
          <div class="benefit"><h3>Abstimmung &amp; Abgleich</h3><p>Unterstützung der Reconciliation zwischen externen Zahlungsdaten und D365 Finance.</p></div>
          <div class="benefit"><h3>Regelbasierte Verarbeitung</h3><p>Wiederkehrende Prozesse lassen sich konsistent automatisieren.</p></div>
          <div class="benefit"><h3>Fehlerreduktion</h3><p>Strukturierte Prüfungen und klar definierte Regeln reduzieren manuelle Fehler.</p></div>
          <div class="benefit"><h3>Transparenz</h3><p>Nachvollziehbare Verarbeitung schafft eine bessere Grundlage für Reporting und Kontrolle.</p></div>
          <div class="benefit"><h3>Effizienz &amp; Skalierbarkeit</h3><p>Einheitliche Prozesse reduzieren Aufwand und lassen sich auf weitere Quellen ausweiten.</p></div>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container crosslink">
        <span class="eyebrow">Weitere Integrationen</span>
        <h2>Direkte Bankanbindung über EBICS und SFTP</h2>
        <p>Für klassische Bankkommunikation und den automatisierten Import von Kontoauszügen bieten wir eine separate Banking Integration für Microsoft Dynamics 365 Finance.</p>
        <a class="more" href="/banking-integration">Mehr zu Banking Integration →</a>
      </div>
    </section>

    <section class="service-cta">
      <div class="container service-cta-inner">
        <div>
          <span class="eyebrow">Payment Integration</span>
          <h2>Zahlungs- und Abrechnungsprozesse in D365 Finance automatisieren</h2>
          <p>Wir unterstützen bei Konzeption, Datenmapping, Integration, Testing, Produktivsetzung und Optimierung.</p>
        </div>
        <a class="btn btn-primary" href="mailto:contact@simplifi.solutions?subject=Payment%20Integration%20D365%20Finance">Kontakt aufnehmen</a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .service-hero {
    background:
      radial-gradient(circle at 82% 18%, rgba(11,103,227,.20), transparent 35%),
      linear-gradient(120deg, #071a33 0%, #0a2343 62%, #0b3766 100%);
    color: #fff;
  }
  .service-hero-inner { max-width: 920px; padding: 96px 0 88px; }
  .service-kicker {
    display:block; margin-bottom:18px; color:var(--blue-light);
    text-transform:uppercase; letter-spacing:.12em; font-size:.78rem; font-weight:800;
  }
  .service-hero h1 {
    max-width:920px; margin:0 0 24px; font-size:clamp(2.7rem,6vw,4.9rem);
    line-height:1.02; letter-spacing:-.05em;
  }
  .service-lead { max-width:820px; margin:0 0 30px; color:#dce9f7; font-size:1.14rem; }
  .service-actions { display:flex; flex-wrap:wrap; gap:14px; }
  .service-visual {
    margin-top:34px; overflow:hidden; border:1px solid var(--line); border-radius:16px;
    background:#fff; box-shadow:0 18px 48px rgba(12,27,47,.08);
  }
  .service-visual img { display:block; width:100%; height:auto; }
  .visual-caption { margin:14px 4px 0; color:var(--muted); font-size:.88rem; text-align:center; }
  .service-grid { display:grid; gap:20px; }
  .service-grid.three { grid-template-columns:repeat(3,1fr); }
  .service-grid.four { grid-template-columns:repeat(4,1fr); }
  .service-card {
    padding:28px; border:1px solid var(--line); border-radius:12px; background:#fff;
    box-shadow:0 12px 34px rgba(12,27,47,.05);
  }
  .service-card h3 { margin:10px 0; }
  .service-card p { margin:0; color:var(--muted); }
  .card-tag {
    color:var(--blue); font-size:.75rem; font-weight:800; letter-spacing:.1em; text-transform:uppercase;
  }
  .service-split { display:grid; grid-template-columns:1fr 1fr; gap:72px; align-items:center; }
  .service-split h2,.crosslink h2,.service-cta h2 {
    margin:10px 0 18px; font-size:clamp(2rem,4vw,3rem); line-height:1.08; letter-spacing:-.035em;
  }
  .service-split p,.crosslink p { color:var(--muted); }
  .format-list,.process-list { display:grid; gap:12px; margin-top:24px; }
  .format-list div,.process-list div {
    padding:17px 18px; border:1px solid var(--line); border-left:4px solid var(--blue);
    border-radius:8px; background:#fff;
  }
  .format-list strong,.format-list span,.process-list strong,.process-list span { display:block; }
  .format-list span,.process-list span { margin-top:4px; color:var(--muted); font-size:.92rem; }
  .benefit-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:18px; }
  .benefit {
    padding:24px; border-top:3px solid var(--blue); border-radius:0 0 10px 10px;
    background:#fff; box-shadow:0 10px 30px rgba(12,27,47,.05);
  }
  .benefit h3 { margin:0 0 8px; }
  .benefit p { margin:0; color:var(--muted); }
  .crosslink {
    border:1px solid #d7e3f2; border-radius:16px; padding:36px;
    background:linear-gradient(135deg,#f8fbff 0%,#eef5ff 100%);
  }
  .crosslink .more { display:inline-block; margin-top:8px; }
  .service-cta { background:var(--navy); color:#fff; }
  .service-cta-inner { display:flex; justify-content:space-between; gap:50px; align-items:center; padding:62px 0; }
  .service-cta p { margin-bottom:0; color:#c9d8e8; }
  @media(max-width:950px){
    .service-grid.four{grid-template-columns:repeat(2,1fr)}
    .service-grid.three,.benefit-grid{grid-template-columns:repeat(2,1fr)}
    .service-split{grid-template-columns:1fr;gap:38px}
  }
  @media(max-width:620px){
    .service-hero-inner{padding:70px 0 64px}
    .service-grid.three,.service-grid.four,.benefit-grid{grid-template-columns:1fr}
    .service-cta-inner{align-items:flex-start;flex-direction:column}
    .crosslink{padding:26px}
  }
</style>
